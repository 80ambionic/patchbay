{
  "version": 3,
  "configurePresets": [
    {
      "name": "macos",
      "displayName": "macOS (Xcode)",
      "generator": "Xcode",
      "binaryDir": "${sourceDir}/build/macos",
      "cacheVariables": { "CMAKE_OSX_DEPLOYMENT_TARGET": "12.0" }
    },
    {
      "name": "ios",
      "displayName": "iOS / iPadOS (Xcode)",
      "generator": "Xcode",
      "binaryDir": "${sourceDir}/build/ios",
      "cacheVariables": {
        "CMAKE_SYSTEM_NAME": "iOS",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "16.0"
      }
    }
  ]
}
